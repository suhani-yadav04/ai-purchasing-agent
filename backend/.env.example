# Optional. If unset, the agent runs fully deterministically (no LLM calls
# at all) -- every decision, quantity, and validation step works without it.
# If set, /agent/decide accepts "use_llm_explanation": true to get a
# natural-language rewrite of the (unchanged) deterministic explanation.
ANTHROPIC_API_KEY=

# Optional. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./buyer_agent.db
